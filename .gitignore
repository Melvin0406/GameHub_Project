# Backend specific
backend/node_modules/
backend/.env
backend/gamehub.sqlite
backend/gamehub.sqlite-journal # Archivos temporales de SQLite
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
backend/gamehub_local_db.sqlite

# Si tienes una carpeta de logs en el backend
backend/logs/

# Nginx Portable - Archivos generados y sensibles
nginx/logs/
nginx/temp/
nginx/html/hls_stream_data/

# Archivos de Sistema Operativo
.DS_Store
Thumbs.db
*.swp

# Archivos de IDEs
.vscode/
.idea/

# Otros archivos temporales o de caché
*.cache

# Archivos de configuración de FTP
ftp_storage/
backend/uploads/
backend/public/

# Nginx portátil: el binario y los assets vendor NO se versionan.
# Descarga un build de nginx-rtmp y colócalo en nginx/ (ver README).
nginx/nginx.exe
nginx/*.dll
nginx/html/*.swf
nginx/html/swfobject.js
nginx/html/stat.xsl
nginx/html/crossdomain.xml
nginx/html/50x.html
nginx/html/vod.html
